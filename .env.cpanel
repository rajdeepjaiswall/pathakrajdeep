# Environment Configuration for cPanel Deployment
# Replace these values with your actual cPanel hosting details

# Application Settings
NODE_ENV=production
PORT=3000

# MySQL Database Configuration (Replace with your cPanel MySQL details)
DATABASE_URL=mysql://your_mysql_username:your_mysql_password@localhost:3306/your_database_name

# Security Keys (Generate new secure keys for production)
SESSION_SECRET=your-session-secret-key-here-generate-new-one
JWT_SECRET=your-jwt-secret-key-here-generate-new-one

# Optional: Email Configuration
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com  
# SMTP_PASS=your-email-password

# Optional: Payment Gateway
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional: File Storage
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Application URLs (Replace with your actual domain)
# FRONTEND_URL=https://yourdomain.com
# BACKEND_URL=https://yourdomain.com